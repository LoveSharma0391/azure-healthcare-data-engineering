{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-healthcare-dev-01"
		},
		"LS_AzureSQL_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL'"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sthealthrcmdev01.dfs.core.windows.net/"
		},
		"LS_AzureSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-healthcare-dev-01.database.windows.net"
		},
		"LS_AzureSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "EMR_DB"
		},
		"LS_AzureSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"LS_HTTP_Function_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://func-healthcare-dev-baeqdeg7gsedftdf.centralindia-01.azurewebsites.net"
		},
		"LS_REST_Function_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://func-healthcare-dev-baeqdeg7gsedftdf.centralindia-01.azurewebsites.net"
		},
		"TR_Claims_File_Arrival_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/4b5fd168-baae-440f-aafa-7bc715c82b99/resourceGroups/rg-healthcare-dev/providers/Microsoft.Storage/storageAccounts/sthealthrcmdev01"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-healthcare-dev-01_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_AzureSQL_password": {
						"value": "[parameters('LS_AzureSQL_password')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_AzureSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_properties_typeProperties_userName')]"
					},
					"LS_HTTP_Function_properties_typeProperties_url": {
						"value": "[parameters('LS_HTTP_Function_properties_typeProperties_url')]"
					},
					"LS_REST_Function_properties_typeProperties_url": {
						"value": "[parameters('LS_REST_Function_properties_typeProperties_url')]"
					},
					"TR_Claims_File_Arrival_properties_typeProperties_scope": {
						"value": "[parameters('TR_Claims_File_Arrival_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}